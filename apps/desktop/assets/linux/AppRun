#!/usr/bin/env bash
set -euo pipefail

app_dir="${APPDIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}"
for argument in "$@"; do
  case "$argument" in
    --no-sandbox|--no-sandbox=*|--disable-*-sandbox|--disable-*-sandbox=*)
      echo 'DSH Desktop requires the Chromium sandbox.' >&2
      exit 1
      ;;
  esac
done

export APPDIR="$app_dir"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$APPDIR/dsh-desktop" "$@"
